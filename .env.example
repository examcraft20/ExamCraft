# ============================================================
# ExamCraft Root Environment Variables
# ============================================================
# For app-specific variables, see:
#   - apps/api/.env.example  (API / NestJS)
#   - apps/web/.env.example  (Web / Next.js)
# ============================================================

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
DATABASE_URL=
POSTGRES_PASSWORD=

# --- API ---
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- AI ---
GEMINI_API_KEY=

# --- Mailing ---
RESEND_API_KEY=

# --- Internal Secrets ---
JWT_SECRET=

# --- Sentry Configuration (replace with your project's DSN) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
